{
  "name": "cloud-migration-cockpit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres redis minio mailpit",
    "dev:web": "npm run dev -w apps/web -- --hostname 127.0.0.1 --port 3000",
    "build:web": "npm run build -w apps/web",
    "lint:web": "npm run lint -w apps/web",
    "typecheck:web": "npm run typecheck -w apps/web",
    "test:web": "npm run test -w apps/web",
    "dev:api": "UV_CACHE_DIR=.uv-cache uv run uvicorn services.api.app.main:app --reload --port 8000",
    "dev:worker": "UV_CACHE_DIR=.uv-cache uv run uvicorn services.worker.app.main:app --reload --port 8001",
    "scan:worker": "UV_CACHE_DIR=.uv-cache uv run python -m services.worker.app.cli scan demo-systems/legacycart",
    "dev:stack": "python3 scripts/dev_stack.py",
    "lint:py": "UV_CACHE_DIR=.uv-cache uv run ruff check services",
    "typecheck:py": "UV_CACHE_DIR=.uv-cache uv run mypy services",
    "test:py": "UV_CACHE_DIR=.uv-cache uv run pytest",
    "test": "npm run test:web && npm run test:py",
    "static": "npm run lint:web && npm run typecheck:web && npm run lint:py && npm run typecheck:py"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "better-auth": "^1.6.4",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
