{
  "name": "cloud-migration-cockpit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres redis minio",
    "dev:web": "npm run dev -w apps/web -- --hostname 127.0.0.1 --port 3000",
    "build:web": "npm run build -w apps/web",
    "lint:web": "npm run lint -w apps/web",
    "test:web": "npm run test -w apps/web",
    "dev:api": "uv run uvicorn services.api.app.main:app --reload --port 8000",
    "dev:worker": "uv run uvicorn services.worker.app.main:app --reload --port 8001",
    "scan:worker": "uv run python -m services.worker.app.cli scan demo-systems/legacycart",
    "dev:stack": "python3 scripts/dev_stack.py",
    "lint:py": "uv run ruff check services",
    "test:py": "uv run pytest",
    "test": "npm run test:web && npm run test:py"
  }
}
